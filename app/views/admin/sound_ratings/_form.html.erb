<%= simple_form_for([:admin, @sound_rating]) do |f| %>
  <%= f.error_notification %>
  <% if f.error(:base).present? && f.error(:base) != '<div></div>' %>
    <div class="mt-1 alert alert-danger w-100">
      <%= f.error(:base) %>
    </div>
  <% end %>
  <div class="row small-gutters">
    <%= render 'admin/shared/edit/sidebar', f: f, record: @sound_rating %>
    <div class="col-md-9">
      <div class="card">
        <h1 class="h2 card-header"><%= record_name(@sound_rating) %></h1>
        <div class="card-body">
          <div class="form-inputs">
            <div class="row small-gutters">
              <div class="col-md-6">
                <%= f.association :sound %>
                <%= f.input :rating %>
                <%= f.input :browser_identifier %>
                <%= f.input :ip_address %>
                <%= f.input :user_agent %>
                <%= f.input :referrer %>
              </div>
              <div class="col-md-6">
                <% if f.object.sound.present? %>
                  <p>
                    <%= link_to 'Edit Sound', edit_admin_sound_path(f.object.sound), class: 'btn btn-secondary', role: 'button' %>
                  </p>
                <% end %>
                <%= f.button :submit, class: 'btn-success d-md-none' %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
