<div class="table-responsive">
  <%= content_tag :table, class: 'forest-table table table-striped table-sm' do %>
    <thead>
      <tr>
        <% if SoundRating.statusable? %>
          <th></th>
        <% end %>
        <th><%= table_sorter title: 'ID', path: :admin_sound_ratings_path, scope: :by_id, default_order: :desc %></th>
        <th>Sound</th>
        <th>Rating</th>
        <th>Browser Identifier</th>
        <th>Ip Address</th>
        <th>User Agent</th>
        <th>Referrer</th>
        <th><%= table_sorter title: 'Created&nbsp;at'.html_safe, path: :admin_sound_ratings_path, scope: :by_created_at, default_order: :desc %></th>
        <th><%= table_sorter title: 'Updated&nbsp;at'.html_safe, path: :admin_sound_ratings_path, scope: :by_updated_at, default_order: :desc %></th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% records.includes(:sound).each do |sound_rating| %>
        <%= content_tag :tr do %>
          <% if SoundRating.statusable? %>
            <td><%= status_indicator sound_rating %></td>
          <% end %>
          <td><%= sound_rating.id %></td>
          <td>
            <% if sound_rating.sound.present? %>
              <%= link_to record_name(sound_rating.sound), edit_admin_sound_path(sound_rating.sound) %>
            <% else %>
              —
            <% end %>
          </td>
          <td><%= sound_rating.rating %></td>
          <td><%= sound_rating.browser_identifier %></td>
          <td><%= sound_rating.ip_address %></td>
          <td><%= sound_rating.user_agent %></td>
          <td><%= sound_rating.referrer %></td>
          <td><%= forest_date sound_rating.created_at %></td>
          <td><%= forest_date sound_rating.updated_at %></td>
          <td width="1">
            <%= link_to 'Edit', edit_admin_sound_rating_path(sound_rating), class: 'btn btn-xs btn-primary', role: 'button' %>
          </td>
          <% if try('sound_rating_path', sound_rating) %>
            <% if sound_rating.respond_to?(:to_friendly_param) %>
              <% param = sound_rating.to_friendly_param %>
            <% else %>
              <% param = sound_rating %>
            <% end %>
            <td width="1">
              <%= link_to 'Show', sound_rating_path(param), class: 'btn btn-xs btn-info', role: 'button', data: { turbolinks: false } %>
            </td>
          <% end %>
          <td width="1">
            <%= link_to 'Destroy', [:admin, sound_rating], method: :delete, class: 'btn btn-xs btn-danger', role: 'button', data: { confirm: 'Are you sure you want to destroy this Sound Rating?' } %>
          </td>
        <% end %>
      <% end %>
    </tbody>
  <% end %>
</div>

<%= pagy_bootstrap_nav_js(pagy).html_safe if pagy.pages > 1 %>
