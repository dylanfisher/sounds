<%= simple_form_for([:admin, @sound]) do |f| %>
  <%= f.error_notification %>
  <% if f.error(:base).present? && f.error(:base) != '<div></div>' %>
    <div class="mt-1 alert alert-danger w-100">
      <%= f.error(:base) %>
    </div>
  <% end %>
  <div class="row small-gutters mb-3">
    <%= render 'admin/shared/edit/sidebar', f: f, record: @sound %>
    <div class="col-md-9">
      <div class="card">
        <h1 class="h2 card-header"><%= record_name(@sound) %></h1>
        <div class="card-body">
          <div class="form-inputs">
            <div class="row small-gutters">
              <div class="col-md-6">
                <%= f.input :title %>
                <%= f.association :artist %>
                <%= render 'admin/form_inputs/slug', f: f %>
                <%= f.input :date, as: :datepicker %>
                <%= f.input :description, markdown: true %>
              </div>
              <div class="col-md-6">
                <%= render 'admin/form_inputs/status', f: f, record: @sound %>
                <%= f.association :media_item, label: 'mp3 File', remote: { path: admin_media_items_path(audio: true) } %>
                <%= f.input :stars %>
                <%= f.input :waveform %>
                <% if f.object.waveform.blank? && !@sound.new_record? %>
                  <p class="text-muted small">Waveform data is generated automatically on the server after save.</p>
                <% end %>
                <%= f.button :submit, class: 'btn-success d-md-none' %>
              </div>
            </div>

            <% unless f.object.new_record? %>
              <hr>
              <div class="row small-gutters">
                <div class="col">
                  <h2 class="h4">Ratings</h2>
                  <p class="mb-2">
                    <strong>Average:</strong> <%= @sound.stars || 0 %>/5
                    &nbsp;
                    <strong>Total ratings:</strong> <%= @sound.sound_ratings.count %>
                  </p>

                  <% if @sound_ratings.any? %>
                    <div class="table-responsive">
                      <table class="table table-sm table-striped">
                        <thead>
                          <tr>
                            <th>When</th>
                            <th>Rating</th>
                            <th>IP</th>
                            <th>Browser ID</th>
                            <th>User Agent</th>
                            <th>Referrer</th>
                            <th></th>
                          </tr>
                        </thead>
                        <tbody>
                          <% @sound_ratings.each do |rating| %>
                            <tr>
                              <td class="text-nowrap"><%= forest_date(rating.created_at) %></td>
                              <td><%= rating.rating %>/5</td>
                              <td class="text-nowrap"><%= rating.ip_address.presence || '—' %></td>
                              <td><code><%= rating.browser_identifier %></code></td>
                              <td><%= rating.user_agent.to_s.truncate(80).presence || '—' %></td>
                              <td><%= rating.referrer.to_s.truncate(80).presence || '—' %></td>
                              <td class="text-nowrap">
                                <%= link_to 'Edit', edit_admin_sound_rating_path(rating), class: 'btn btn-xs btn-primary', role: 'button' %>
                              </td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    </div>

                    <%= pagy_bootstrap_nav_js(@sound_ratings_pagy).html_safe if @sound_ratings_pagy.pages > 1 %>
                  <% else %>
                    <p class="mb-0">No ratings yet.</p>
                  <% end %>
                </div>
              </div>

              <hr>
              <div class="row small-gutters">
                <div class="col">
                  <%= link_to 'Reprocess media item mp3 metadata', reprocess_mp3_admin_sound_path, target: '_blank', class: 'btn btn-secondary' %>
                  <pre>
                    <code>
  <%= JSON.pretty_generate(f.object.try(:media_item).try(:sound_metadata)) %>
                    </code>
                  </pre>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
